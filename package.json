  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250109.0",
    "@typescript-eslint/parser": "8.71.0",
    "esbuild": "0.27.3",
    "eslint": "10.12.0",
    "miniflare": "4.20260409.0",
    "typescript": "^5.7.2",
    "wrangler": "^4.116.0"

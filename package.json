    "@modelcontextprotocol/sdk": "1.32.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.0.0",
    "@typescript-eslint/parser": "8.72.2",
    "esbuild": "0.28.1",
    "eslint": "10.12.0",
    "miniflare": "4.20260409.0",
    "typescript": "^5.7.2",
    "wrangler": "^4.116.0"
  }

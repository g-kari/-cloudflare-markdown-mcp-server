  "description": "Cloudflare AI Markdown変換APIをClaude Code/CodexなどのAIエージェントから使えるMCPサーバー",
  "private": true,
  "scripts": {
    "start": "wrangler dev",
    "deploy": "wrangler deploy",
    "build": "tsc --noEmit",
